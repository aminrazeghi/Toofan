{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      turbulenceProperties;
}

{% if turbulence.laminar %}
simulationType  laminar;
{% else %}
simulationType  RAS;

RAS
{
    RASModel        {{ turbulence.model }};
    turbulence      on;
    printCoeffs     on;
}
{% endif %}

