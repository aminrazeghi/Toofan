{% if turbulence.usesOmega %}
{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform {{ flow.omega }};

boundaryField
{
{% include "emptyPatches" %}
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    tunnelWalls
    {
        type            slip;
    }
    {{ surface.group }}
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}

// ************************************************************************* //
{% endif %}
