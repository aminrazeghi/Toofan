{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform {{ vec(flow.U) }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    tunnelWalls
    {
        type            slip;
    }
    {{ surface.group }}
    {
        type            noSlip;
    }
}

