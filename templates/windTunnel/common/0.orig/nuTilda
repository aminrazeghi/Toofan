{% if turbulence.usesNuTilda %}
{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform {{ flow.nuTilda }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    tunnelWalls
    {
        type            slip;
    }
    {{ surface.group }}
    {
        type            fixedValue;
        value           uniform 0;
    }
}

// ************************************************************************* //
{% endif %}
