{% if turbulence.usesEpsilon %}
{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform {{ flow.epsilon }};

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    tunnelWalls
    {
        type            slip;
    }
    {{ surface.group }}
    {
        type            epsilonWallFunction;
        value           $internalField;
    }
}

// ************************************************************************* //
{% endif %}
