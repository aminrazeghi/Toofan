{% include "banner" %}
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    "(inlet|outlet|tunnelWalls)"
    {
        type            calculated;
        value           uniform 0;
    }
    {{ surface.group }}
    {
        type            compressible::alphatWallFunction;
        value           uniform 0;
    }
}

